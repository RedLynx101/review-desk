# Copy to .env. Every value has a working default for a local LM Studio server.

# The only host the app ever contacts. Any OpenAI-compatible server works, local or your own.
REVIEW_DESK_MODEL_BASE_URL=http://localhost:1234/v1
REVIEW_DESK_MODEL=prism-ml/bonsai-27b
REVIEW_DESK_MODEL_API_KEY=not-needed-for-local

# A shared local server can queue a request for minutes before it starts.
REVIEW_DESK_MODEL_TIMEOUT_SECONDS=1200
REVIEW_DESK_MODEL_MAX_TOKENS=3500
REVIEW_DESK_MODEL_TEMPERATURE=0
REVIEW_DESK_MODEL_RETRIES=3

# Attach page images for scanned pages. Vision models only.
REVIEW_DESK_MODEL_SEND_IMAGES=false

# Port for the review desk. It listens on localhost.
REVIEW_DESK_PORT=8765

# Upload limits. Uploads are untrusted.
REVIEW_DESK_MAX_UPLOAD_BYTES=26214400
REVIEW_DESK_MAX_PAGES=20
REVIEW_DESK_MAX_RENDER_PIXELS=40000000

# Path to the tesseract program, if it isn't on PATH or in a usual install folder.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
REVIEW_DESK_OCR_DPI=300
REVIEW_DESK_OCR_TIMEOUT_SECONDS=180

# Compare each PDF's text layer with what the page shows. Costs a few seconds per page.
REVIEW_DESK_VERIFY_TEXT_LAYER=true
